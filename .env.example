# NammaNudi Environment Configuration Template
# Copy this file to .env and configure as needed for local overrides.

# Backend Port
SERVER_PORT=8081

# Frontend allowed origins for CORS (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend Vite Backend API Proxy / Target URL
VITE_API_BASE_URL=http://localhost:8081
